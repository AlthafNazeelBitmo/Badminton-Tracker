{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci --include=dev --workspace @badminton/api --include-workspace-root",
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [{ "path": "/api/v1/internal/cron", "schedule": "0 12 * * *" }]
}
