# =============================================================================
# Badminton Tracker — mobile app environment
#
# Copy to `.env.local` for local development. Never commit a real `.env.local`.
#
# Everything here is compiled into the app binary and can be read out of it by
# anyone who downloads it. `EXPO_PUBLIC_` is not a suggestion — it is a statement
# of fact about every value in this file. API keys, secrets and tokens belong on
# the server, behind an endpoint the app calls.
# =============================================================================

# Base URL of the API, including the version prefix.
#
# `localhost` only works in a simulator, which shares the host's network stack. A
# physical phone is a different machine, so it needs your machine's LAN address —
# the one `expo start` prints in the connection URL. Getting this wrong looks like
# the phone being offline, which sends you debugging the wrong thing entirely.
#
#   Simulator / emulator : http://localhost:4000/api/v1
#   Physical device      : http://192.168.1.x:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Which variant to build: development | preview | production.
#
# Each installs under its own bundle identifier so all three can sit on one device
# without overwriting each other — and, more to the point, without one of them
# deleting the local match database belonging to another.
APP_VARIANT=development

# EAS project id, from `eas init`. Only needed for cloud builds and OTA updates;
# leave unset for local development.
EAS_PROJECT_ID=
