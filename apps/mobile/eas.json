{
  "$schema": "https://raw.githubusercontent.com/expo/eas-cli/main/schema/eas.json",
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.11.0",
      "env": {
        "NODE_ENV": "production"
      }
    },

    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "ios": { "simulator": true },
      "android": { "buildType": "apk" }
    },

    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "preview"
      },
      "android": { "buildType": "apk" }
    },

    "production": {
      "extends": "base",
      "channel": "production",
      "env": {
        "APP_VARIANT": "production"
      },
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    }
  },

  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "../../secrets/play-service-account.json",
        "track": "internal"
      }
    }
  }
}
