# =============================================================================
# Badminton Tracker — environment configuration
#
# Copy to `.env` for local development. Never commit a real `.env`.
# Every variable the API reads is listed here; the API fails fast at boot if a
# required one is missing or invalid (see apps/api/src/config/env.ts).
# =============================================================================

# --- Runtime ----------------------------------------------------------------
# development | test | staging | production
NODE_ENV=development
# Port the API listens on.
PORT=4000
# Public origin of the API, used in emailed links.
API_PUBLIC_URL=http://localhost:4000
# Public origin of the web app. Also the only allowed CORS origin.
WEB_PUBLIC_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. Add `?sslmode=require` for managed databases.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/badminton?schema=public
# Separate database used by the integration test suite. It is TRUNCATED between
# test files, so it must never point at a database holding real data.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/badminton_test?schema=public

# --- Authentication ---------------------------------------------------------
# Signing secret for access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. The API refuses to boot in production with a
# default or short value.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
# Separate secret for refresh tokens so leaking one does not compromise the other.
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string-32-chars
# Access token lifetime in seconds (default 15 minutes).
ACCESS_TOKEN_TTL=900
# Refresh token lifetime in seconds (default 30 days).
REFRESH_TOKEN_TTL=2592000
# Cookie domain. Leave blank for host-only cookies (correct for localhost).
COOKIE_DOMAIN=
# Send cookies only over HTTPS. Must be true in production.
COOKIE_SECURE=false

# --- Rate limiting ----------------------------------------------------------
# Requests allowed per window, per client, for general endpoints.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
# Tighter budget for authentication endpoints, which are the brute-force target.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- Observability ----------------------------------------------------------
# error | warn | log | debug | verbose
LOG_LEVEL=log
# Emit one JSON object per line instead of pretty text. Enable in production.
LOG_JSON=false
# Requests slower than this (ms) are logged as warnings.
SLOW_REQUEST_MS=750
# Optional Sentry DSN. Leave blank to disable error reporting.
SENTRY_DSN=

# --- Features ---------------------------------------------------------------
# Serve Swagger UI at /api/docs. Disable in production unless docs are public.
ENABLE_SWAGGER=true
# Allow new account registration.
ALLOW_REGISTRATION=true

# --- Web app (apps/web) -----------------------------------------------------
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Base URL the Next.js server uses for server-side fetches. Inside Docker this
# is the API container's name, e.g. http://api:4000.
API_INTERNAL_URL=http://localhost:4000
