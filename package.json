{
  "name": "badminton-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Industrial-grade badminton performance tracking and analytics platform",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "npm run build -w @badminton/contracts -w @badminton/analytics",
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @badminton/api",
    "dev:web": "npm run dev -w @badminton/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test -w @badminton/analytics -w @badminton/contracts",
    "test:e2e": "npm run test:e2e -w @badminton/api",
    "db:generate": "npm run db:generate -w @badminton/api",
    "db:migrate": "npm run db:migrate -w @badminton/api",
    "db:deploy": "npm run db:deploy -w @badminton/api",
    "db:seed": "npm run db:seed -w @badminton/api",
    "db:reset": "npm run db:reset -w @badminton/api",
    "db:studio": "npm run db:studio -w @badminton/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
